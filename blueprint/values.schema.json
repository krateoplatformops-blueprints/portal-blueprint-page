{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "blueprint": {
      "additionalProperties": false,
      "description": "Blueprint properties",
      "properties": {
        "credentials": {
          "additionalProperties": false,
          "description": "Authentication configuration for private registries",
          "properties": {
            "passwordRef": {
              "additionalProperties": false,
              "description": "Reference to a secret containing the registry password or token",
              "properties": {
                "key": {
                  "default": "",
                  "description": "Secret key",
                  "title": "key",
                  "type": "string"
                },
                "name": {
                  "default": "",
                  "description": "Secret name",
                  "title": "name",
                  "type": "string"
                },
                "namespace": {
                  "default": "",
                  "description": "Secret namespace",
                  "title": "namespace",
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name",
                "namespace"
              ],
              "title": "passwordRef",
              "type": "object"
            },
            "username": {
              "default": "",
              "description": "Registry username",
              "title": "username",
              "type": "string"
            }
          },
          "title": "credentials",
          "type": "object"
        },
        "hasPage": {
          "default": true,
          "description": "Blueprints dedicated page (Composition)",
          "title": "hasPage",
          "type": "boolean"
        },
        "url": {
          "default": "",
          "description": "Blueprints url",
          "title": "url",
          "type": "string"
        },
        "version": {
          "default": "",
          "description": "Blueprints version",
          "title": "version",
          "type": "string"
        }
      },
      "required": [
        "url",
        "version"
      ],
      "title": "blueprint",
      "type": "object"
    },
    "form": {
      "additionalProperties": false,
      "description": "Blueprint form properties",
      "properties": {
        "alphabeticalOrder": {
          "default": false,
          "description": "Blueprint form keys order",
          "title": "alphabeticalOrder",
          "type": "boolean"
        },
        "hasPage": {
          "default": true,
          "description": "Blueprints dedicated page (Blueprint)",
          "title": "hasPage",
          "type": "boolean"
        },
        "instructions": {
          "default": "",
          "description": "Blueprints form instructions",
          "title": "instructions",
          "type": "string"
        }
      },
      "title": "form",
      "type": "object"
    },
    "panel": {
      "additionalProperties": false,
      "description": "Blueprint panel properties",
      "properties": {
        "icon": {
          "additionalProperties": false,
          "description": "Blueprint panel icon properties",
          "properties": {
            "name": {
              "default": "",
              "description": "Bleprint panel icon name",
              "title": "name",
              "type": "string"
            }
          },
          "title": "icon",
          "type": "object"
        },
        "title": {
          "default": "",
          "description": "Blueprint panel title",
          "title": "title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "panel",
      "type": "object"
    }
  },
  "required": [
    "blueprint",
    "panel"
  ],
  "type": "object"
}