{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "blueprint": {
      "additionalProperties": false,
      "description": "Blueprint properties",
      "properties": {
        "credentials": {
          "additionalProperties": false,
          "description": "Credentials for private blueprint registry",
          "properties": {
            "passwordRef": {
              "additionalProperties": false,
              "description": "Reference to a secret containing the password",
              "properties": {
                "key": {
                  "default": "",
                  "description": "Key in the secret",
                  "title": "key",
                  "type": "string"
                },
                "name": {
                  "default": "",
                  "description": "Name of the secret",
                  "title": "name",
                  "type": "string"
                },
                "namespace": {
                  "default": "",
                  "description": "Namespace of the secret",
                  "title": "namespace",
                  "type": "string"
                }
              },
              "title": "passwordRef",
              "type": "object"
            },
            "username": {
              "default": "",
              "description": "Username for registry authentication",
              "title": "username",
              "type": "string"
            }
          },
          "title": "credentials",
          "type": "object"
        },
        "hasPage": {
          "default": true,
          "description": "Blueprints dedicated page (Composition)",
          "title": "hasPage",
          "type": "boolean"
        },
        "repo": {
          "description": "Blueprints repo name. If empty, the global.compositionName value will be used for retrocompatibility to portal-blueprint-version 1.0.5",
          "title": "repo",
          "type": "string"
        },
        "url": {
          "default": "https://marketplace.krateo.io",
          "description": "Blueprints url",
          "title": "url",
          "type": "string"
        },
        "version": {
          "default": "0.0.1",
          "description": "Blueprints version",
          "title": "version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "hasPage"
      ],
      "title": "blueprint",
      "type": "object"
    },
    "form": {
      "additionalProperties": false,
      "description": "Blueprint form properties",
      "properties": {
        "alphabeticalOrder": {
          "default": true,
          "description": "Blueprint form keys order",
          "title": "alphabeticalOrder",
          "type": "boolean"
        }
      },
      "required": [
        "alphabeticalOrder"
      ],
      "title": "form",
      "type": "object"
    },
    "global": {
      "additionalProperties": true,
      "description": "global properties section - if the Helm chart is installed via Composition Dynamic Controller, these are injected by default",
      "properties": {
        "compositionName": {
          "default": "cloudnative-stack",
          "description": "Composition Custom Resource metadata name",
          "examples": [
            "cloudnative-stack"
          ],
          "title": "compositionName",
          "type": "string"
        }
      },
      "title": "global",
      "type": "object"
    },
    "panel": {
      "additionalProperties": false,
      "description": "Blueprint panel properties",
      "properties": {
        "icon": {
          "additionalProperties": false,
          "description": "Blueprint panel icon properties",
          "properties": {
            "name": {
              "default": "fa-cubes",
              "description": "Bleprint panel icon name",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "icon",
          "type": "object"
        },
        "title": {
          "description": "Blueprint panel title",
          "title": "title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "panel",
      "type": "object"
    }
  },
  "required": [
    "blueprint",
    "form",
    "panel"
  ],
  "type": "object"
}